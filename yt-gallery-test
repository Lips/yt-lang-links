<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube Subtitle Gallery</title>
    <script>
        let subtitles = {};
        let players = {};
        let videoData = [
            { id: "UkZxPIZ1ngY", srt: "video1.srt" },
            { id: "dQw4w9WgXcQ", srt: "video2.srt" },
            { id: "3JZ_D3ELwOQ", srt: "video3.srt" },
            { id: "2Vv-BfVoq4g", srt: "video4.srt" },
            { id: "e-ORhEE9VVg", srt: "video5.srt" },
            { id: "L_jWHffIx5E", srt: "video6.srt" }
        ];

        function loadGallery() {
            const gallery = document.getElementById("gallery");
            gallery.innerHTML = "";
            
            videoData.forEach((video, index) => {
                const container = document.createElement("div");
                container.innerHTML = `
                    <div>
                        <iframe id="ytPlayer${index}" width="560" height="315" src="https://www.youtube.com/embed/${video.id}?enablejsapi=1" frameborder="0" allowfullscreen></iframe>
                        <p id="subtitles${index}" style="font-size: 18px; font-weight: bold; margin-top: 10px;"></p>
                    </div>
                `;
                gallery.appendChild(container);
                
                fetchSRT(video.srt, index);
            });
        }

        function fetchSRT(srtFile, index) {
            fetch(srtFile)
                .then(response => response.text())
                .then(data => parseSRT(data, index));
        }

        function parseSRT(data, index) {
            subtitles[index] = [];
            const lines = data.split('\n\n');
            lines.forEach(line => {
                const parts = line.split('\n');
                if (parts.length >= 3) {
                    const time = parts[1].split(' --> ');
                    const start = parseTime(time[0]);
                    const end = parseTime(time[1]);
                    const text = parts.slice(2).join(' ');
                    subtitles[index].push({ start, end, text });
                }
            });
        }

        function parseTime(timeString) {
            const parts = timeString.split(':');
            const secondsParts = parts[2].split(',');
            return (
                parseInt(parts[0]) * 3600 +
                parseInt(parts[1]) * 60 +
                parseInt(secondsParts[0]) +
                parseInt(secondsParts[1]) / 1000
            );
        }

        function syncSubtitles() {
            videoData.forEach((_, index) => {
                const player = document.getElementById(`ytPlayer${index}`);
                if (!player || !subtitles[index] || !player.contentWindow) return;
                player.contentWindow.postMessage('{"event":"listening","id":1}', '*');
                window.addEventListener('message', function(event) {
                    if (typeof event.data === 'string' && event.data.includes('{')) {
                        try {
                            const data = JSON.parse(event.data);
                            if (data.info && data.info.currentTime) {
                                const currentTime = data.info.currentTime;
                                const subtitle = subtitles[index].find(s => currentTime >= s.start && currentTime <= s.end);
                                document.getElementById(`subtitles${index}`).innerText = subtitle ? subtitle.text : "";
                            }
                        } catch (e) {}
                    }
                });
            });
        }

        setInterval(syncSubtitles, 500);
    </script>
</head>
<body onload="loadGallery()">
    <h2>YouTube Subtitle Gallery</h2>
    <div id="gallery"></div>
</body>
</html>
